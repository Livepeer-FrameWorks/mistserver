msgstr "Livepeer-Transcode-ID"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:254
msgid ""
"Load DTSC files as Video on Demand sources, or dtsc:// URLs from other "
"instances for live sources. This is the optimal method to pull live sources "
"from MistServer compatible instances."
msgstr ""
"Laden Sie DTSC-Dateien als Video-on-Demand-Quellen oder dtsc://-URLs von "
"anderen Instanzen für Live-Quellen. Dies ist die optimale Methode, um Live-"
"Quellen von MistServer-kompatiblen Instanzen abzurufen."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:255
msgid "Location of folder to watch for files."
msgstr "Speicherort des Ordners, der auf Dateien überwacht werden soll."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:256
msgid "Location where MistServer can find the input file."
msgstr "Speicherort, an dem MistServer die Eingabedatei finden kann."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:257
msgid "Main directory where files are served from."
msgstr "Hauptverzeichnis, aus dem Dateien bereitgestellt werden."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:258
msgid "Make streams available as a RTP stream, using the SDP"
msgstr "Stellen Sie Streams mithilfe des SDP als RTP-Stream zur Verfügung"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:259
msgid "Make this input run as a simulated live stream"
msgstr "Lassen Sie diese Eingabe als simulierten Live-Stream laufen"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:260
msgid "Max RTP packet size"
msgstr "Maximale RTP-Paketgröße"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:261
msgid "Max track idle time in ms"
msgstr "Maximale Leerlaufzeit der Spur in ms"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:262
msgid "Max. kbps"
msgstr "Max. kbit/s"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:263
msgid "Maximum bitrate"
msgstr "Maximale Bitrate"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:264
msgid "Maximum bitrate of the encoding"
msgstr "Maximale Bitrate der Kodierung"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:265
msgid ""
