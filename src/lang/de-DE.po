#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:247
msgid "Limits the output to a specific H.264 profile"
msgstr "Beschränkt die Ausgabe auf ein bestimmtes H.264-Profil"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:248
msgid ""
"List of sources to overlay on top of each other, in order. If left empty, "
"simply uses the input track without modifications and nothing else."
msgstr ""
"Liste der Quellen, die übereinander gelegt werden sollen, in der "
"Reihenfolge. Wenn es leer bleibt, wird einfach die Eingabespur ohne "
"Änderungen und sonst nichts verwendet."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:249
msgid ""
"Live buffer window in ms. Segments within this range from the live point "
"will be kept in memory"
msgstr ""
"Live-Pufferfenster in ms. Segmente innerhalb dieses Bereichs vom Live-Punkt "
"werden im Speicher gehalten"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:250
msgid "Live playlist limit"
msgstr "Limit für Live-Playlists"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:251
msgid "Live stream DVR buffer time in ms"
msgstr "Live-Stream-DVR-Pufferzeit in ms"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:252
