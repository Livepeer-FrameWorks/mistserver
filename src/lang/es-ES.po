#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:546
msgid "Use a local FFMPEG installed binary to do encoding"
msgstr ""
"Utilice un binario local instalado en FFMPEG para realizar la codificación"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:547
msgid "Use hardcoded broadcasters, rather than using Livepeer's gateway."
msgstr ""
"Utilice emisoras codificadas, en lugar de utilizar la puerta de enlace de "
"Livepeer."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:548
msgid "Use livepeer to transcode video."
msgstr "Utilice livepeer para transcodificar vídeo."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:549
