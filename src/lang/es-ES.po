#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:249
msgid ""
"Live buffer window in ms. Segments within this range from the live point "
"will be kept in memory"
msgstr ""
"Ventana de buffer en vivo en ms. Los segmentos dentro de este rango desde el "
"punto en vivo se mantendrán en la memoria."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:250
msgid "Live playlist limit"
msgstr "Límite de lista de reproducción en vivo"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:251
