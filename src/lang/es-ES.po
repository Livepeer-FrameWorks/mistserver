msgstr "Escribir registro de paquetes"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:604
msgid ""
"Writes log of frame transmit jitter to /tmp/ for each outgoing connection"
msgstr ""
"Escribe el registro de fluctuación de transmisión de tramas en /tmp/ para "
"cada conexión saliente"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:605
msgid "Writes log of full packet contents to /tmp/ for each connection"
msgstr ""
"Escribe el registro del contenido completo del paquete en /tmp/ para cada "
"conexión"

