msgstr "Perfil de transcodificación"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:527
msgid ""
"Transcode will only be active while this many viewers are watching the "
"stream."
msgstr ""
"La transcodificación solo estará activa mientras tantos espectadores estén "
"viendo la transmisión."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:528
