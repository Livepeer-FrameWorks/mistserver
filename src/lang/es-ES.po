msgstr "Seguimiento del tiempo de inactividad (ms)"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:519
msgid "Track inhibitor(s)"
msgstr "Inhibidores de seguimiento"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:520
msgid ""
"Track selector(s) for the audio portion of the source stream. Defaults to "
"'none' so no audio is passed at all."
msgstr ""
"Selector(es) de pista para la parte de audio de la secuencia fuente. El "
"valor predeterminado es \"ninguno\", por lo que no se pasa ningún audio."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:521
msgid ""
"Track selector(s) of the video portion of the source stream. Defaults to "
"highest bit rate video track."
msgstr ""
"Selector(es) de pista de la parte de vídeo de la secuencia fuente. El valor "
"predeterminado es la pista de vídeo con la tasa de bits más alta."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:522
msgid "Tracks"
msgstr "Pistas"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:523
msgid "Tracks to transcode the source into"
msgstr "Pistas para transcodificar la fuente en"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:524
msgid ""
"transcode options (json string)\n"
"raw segment that was rejected (base64 encoded)\n"
"information about the source track (json string)\n"
"first attempted broadcaster URL\n"
"second attempted broadcaster URL or the text \"N/A\" if no secondary was "
"available"
msgstr ""
"opciones de transcodificación (cadena json)\n"
"segmento sin procesar que fue rechazado (codificado en base64)\n"
"información sobre la pista fuente (cadena json)\n"
"primer intento de URL de emisora\n"
"URL del segundo intento de transmisión o el texto \"N/A\" si no había "
"ninguna secundaria disponible"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:525
msgid "Transcode preset"
msgstr "Preestablecido de transcodificación"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:526
