msgid ""
"Maximum distance in milliseconds to fall behind the live point for stable "
"playback."
msgstr ""
"Distancia máxima en milisegundos para quedar detrás del punto en vivo para "
"una reproducción estable."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.xlZUOpLye7/backend-markers.cpp:267
