#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.5nL9WJwhMP/lsp-markers.js:793
msgid ""
"VoD streams serve a media file for on-demand playback - MP4, MKV, FLV, TS, "
"and more are supported."
msgstr ""
"Las transmisiones de VoD sirven un archivo multimedia para reproducción bajo "
"demanda: se admiten MP4, MKV, FLV, TS y más."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.5nL9WJwhMP/lsp-markers.js:794
