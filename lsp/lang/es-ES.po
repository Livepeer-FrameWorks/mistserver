#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.5nL9WJwhMP/lsp-markers.js:329
msgid ""
"Increase the debug level on the General page to see more detail in the logs."
msgstr ""
"Aumente el nivel de depuración en la página General para ver más detalles en "
