msgid "SRT"
msgstr "TER"

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.5nL9WJwhMP/lsp-markers.js:629
msgid ""
"SRT passphrases must be between 10 and 79 characters. Connections fail "
"silently on mismatch."
msgstr ""
"Las frases de contraseña SRT deben tener entre 10 y 79 caracteres. Las "
"conexiones fallan silenciosamente por no coincidir."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.5nL9WJwhMP/lsp-markers.js:630
