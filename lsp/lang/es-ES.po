msgid ""
"Use variables like $stream, $datetime, $day, and $currentMediaTime in "
"recording paths for dynamic file names."
msgstr ""
"Utilice variables como $stream, $datetime, $day y $currentMediaTime en las "
"rutas de grabación para nombres de archivos dinámicos."

