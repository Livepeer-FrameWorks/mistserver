msgid ""
"Use $datetime and $day variables in push paths for automatic date-stamped "
"recordings."
msgstr ""
"Utilice las variables $datetime y $day en las rutas de inserción para "
"grabaciones automáticas con fecha."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.5nL9WJwhMP/lsp-markers.js:745
msgid ""
"Use $stream, $datetime, $day, and $currentMediaTime in file paths to "
"generate unique file names automatically."
msgstr ""
"Utilice $stream, $datetime, $day y $currentMediaTime en las rutas de los "
"archivos para generar nombres de archivos únicos automáticamente."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.5nL9WJwhMP/lsp-markers.js:746
