msgstr "Bitte geben Sie hier Ihr Passwort ein."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.5nL9WJwhMP/lsp-markers.js:451
msgid "Please enter your username here."
msgstr "Bitte geben Sie hier Ihren Benutzernamen ein."

#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.5nL9WJwhMP/lsp-markers.js:452
