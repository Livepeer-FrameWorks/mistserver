#: /var/folders/w8/0_1t6gv14p5gkdjjjvr3dgnm0000gn/T/tmp.5nL9WJwhMP/lsp-markers.js:283
msgid ""
"For 24/7 DVR, add noendlist=1 and append=1 to keep playlists usable across "
