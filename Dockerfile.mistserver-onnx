# syntax=docker/dockerfile:1.7

ARG BUILD_BASE=ubuntu:24.04
ARG RUNTIME_BASE=ubuntu:24.04
# The locked ONNX Runtime/OpenCV prefix, built by Dockerfile.onnx-deps for the same
# profile, platform and BUILD_BASE. CI passes the content-addressed GHCR image by digest
# (scripts/ONNX/dependency_image.sh); build_accelerator_local.sh builds it locally.
ARG ONNX_DEPS_IMAGE
# Selects the runtime-<profile> stage below.
ARG ONNX_PROFILE=cpu

FROM ${ONNX_DEPS_IMAGE} AS onnx_deps

FROM ${BUILD_BASE} AS mist_build

USER root
ENV DEBIAN_FRONTEND=noninteractive
# verify_release.sh runs the ONNX test suite here: its packaging and dependency-script tests
# need jq and unzip, which ubuntu and debian build bases do not ship.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git patch jq unzip \
      python3 python3-pip ninja-build pkg-config cmake ffmpeg \
      libcjson-dev libmbedtls-dev libxml2-dev zlib1g-dev liblzma-dev \
      libavcodec-dev libavfilter-dev libavformat-dev libavutil-dev \
      libswscale-dev libswresample-dev \
      librist-dev libsrt-openssl-dev libsrtp2-dev libusrsctp-dev libssl-dev \
    && python3 -m pip install --break-system-packages 'meson>=1.6.0' 'cmake>=3.28' \
    && rm -rf /var/lib/apt/lists/*

ARG ONNX_PROFILE=cpu
ARG ONNX_DEP_JOBS=4
# The locked NuGet distribution for this profile and platform (accelerator-images.json).
ARG ONNX_RUNTIME_DISTRIBUTION
ARG ONNX_RUN_PROVIDER_TEST=true
ARG ONNX_INSTALL_TEST_PROBE=false
ARG MIST_OPTS
ARG MIST_BUILD_JOBS
ARG DEBUG=3
ARG VERSION=Unknown
ARG TARGETPLATFORM
ARG RELEASE=Docker_${TARGETPLATFORM}

# Every profile links the shared ONNX Runtime and OpenCV from /opt/mist-onnx. CUDA,
# TensorRT and OpenVINO also need a RUNTIME_BASE that carries their vendor userspace.
# The prefix comes prebuilt from ONNX_DEPS_IMAGE; --verify-only refuses one whose stamp is
# not this platform, profile, lock and runtime distribution instead of rebuilding it.
COPY --from=onnx_deps /opt/mist-onnx/ /opt/mist-onnx/
COPY scripts/ONNX/build_dependencies.sh scripts/ONNX/build_openvino_plugin.sh \
     scripts/ONNX/openvino-plugin-cpu.patch scripts/ONNX/dependencies.lock.tsv /src/scripts/ONNX/
RUN /src/scripts/ONNX/build_dependencies.sh --verify-only \
      --prefix /opt/mist-onnx \
      --work-dir /tmp/onnx-deps-verify \
      --profile ${ONNX_PROFILE} \
      --jobs ${ONNX_DEP_JOBS} \
      --runtime-distribution "${ONNX_RUNTIME_DISTRIBUTION}" \
    && rm -rf /tmp/onnx-deps-verify

COPY . /src
RUN mkdir -p /opt/mist-onnx/share/mistserver/onnx \
    && cp /src/scripts/ONNX/prepare_models.sh \
          /src/scripts/ONNX/models.manifest.tsv \
          /src/scripts/ONNX/dependencies.lock.tsv \
          /src/scripts/ONNX/accelerator-images.json \
          /src/scripts/ONNX/RELEASE_CHECKLIST.md \
          /opt/mist-onnx/share/mistserver/onnx/

ENV PKG_CONFIG_PATH=/opt/mist-onnx/lib/pkgconfig
ENV CMAKE_PREFIX_PATH=/opt/mist-onnx
RUN export LD_LIBRARY_PATH="/opt/mist-onnx/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
    && meson setup /build /src \
      --buildtype=debugoptimized \
      --force-fallback-for=mbedtls \
      -DDOCKERRUN=true \
      -DNOUPDATE=true \
      -DDEBUG=${DEBUG} \
      -DVERSION=${VERSION} \
      -DRELEASE=${RELEASE} \
      -DWITH_AV=true \
      -DONNX=enabled \
      -DONNX_PROFILE=${ONNX_PROFILE} \
      -Dstrip=true \
      ${MIST_OPTS} \
    && grep -qE "ONNX AI processing:[[:space:]]+YES \(profile=${ONNX_PROFILE}\)" /build/meson-logs/meson-log.txt \
    && grep -qE 'NDI:[[:space:]]+COMPILED' /build/meson-logs/meson-log.txt \
    && grep -qE 'ONVIF camera discovery:[[:space:]]+YES' /build/meson-logs/meson-log.txt \
    && grep -qE 'Dependency mbedtls for host machine from subproject .* found: YES' /build/meson-logs/meson-log.txt \
    && if [ -n "${MIST_BUILD_JOBS}" ]; then ninja -C /build -j "${MIST_BUILD_JOBS}"; else ninja -C /build; fi \
    && if [ "${ONNX_RUN_PROVIDER_TEST}" = true ]; then \
         /src/scripts/ONNX/prepare_models.sh --dir /tmp/onnx-models yolo26n; \
         ffmpeg -hide_banner -loglevel error -y -f lavfi \
           -i testsrc2=size=640x640 -frames:v 1 /tmp/onnx-test.jpg; \
         /src/scripts/ONNX/verify_release.sh --build-dir /build \
           --expected-profile ${ONNX_PROFILE} --provider ${ONNX_PROFILE} \
           --model /tmp/onnx-models/yolo26n.onnx --image /tmp/onnx-test.jpg; \
       else \
         /src/scripts/ONNX/verify_release.sh --build-dir /build \
           --expected-profile ${ONNX_PROFILE} --provider ${ONNX_PROFILE}; \
       fi \
    && if [ "${ONNX_INSTALL_TEST_PROBE}" = true ]; then \
         install -D -m 0755 /build/test/onnxmodelprobe \
           /opt/mist-onnx/libexec/onnxmodelprobe; \
       fi \
    && DESTDIR=/mist-install ninja -C /build install \
    && mkdir -p /mist-install/usr/local/share/mistserver \
    && (cd /mist-install/usr/local && find . \( -type f -o -type l \) ! -name '*.a' ! -name '*.la' \
          ! -path './include/*' ! -path './lib/pkgconfig/*' ! -path './lib/*/pkgconfig/*' | sort) \
         > /mist-install/usr/local/share/mistserver/installed-files.txt \
    && echo ./share/mistserver/installed-files.txt >> /mist-install/usr/local/share/mistserver/installed-files.txt \
    && cp -a /mist-install/usr/local/. /usr/local/ \
    && test -x /usr/local/bin/MistProcONNX

ARG OUTPUT_DBG
RUN if [ -n "${OUTPUT_DBG+x}" ]; then \
      tar cf - /build /src /opt/mist-onnx | gzip -6 | curl --upload-file - "${OUTPUT_DBG}"; \
    fi

# Headers are build inputs only; the runtime layer keeps the shared libraries and notices.
RUN rm -rf /opt/mist-onnx/include

# Only MistServer's own installed files reach the runtime layer. The build base's
# /usr/local also holds its toolchain (the devel CUDA toolkit, pip build tools).
RUN tar -C /mist-install/usr/local -cf /mist-runtime.tar \
      -T /mist-install/usr/local/share/mistserver/installed-files.txt \
    && mkdir -p /mist-runtime/usr/local \
    && tar -C /mist-runtime/usr/local -xf /mist-runtime.tar

FROM ${RUNTIME_BASE} AS runtime-cpu
FROM ${RUNTIME_BASE} AS runtime-cuda
FROM ${RUNTIME_BASE} AS runtime-tensorrt
# The OpenVINO runtime base points LD_LIBRARY_PATH at its own /opt/intel/openvino copy. Mist
# and every library in /opt/mist-onnx/lib carry DT_RPATH, which the loader searches before
# LD_LIBRARY_PATH, so they load the OpenVINO the plugin bundles; Mist uses nothing from there.
FROM ${RUNTIME_BASE} AS runtime-openvino

FROM runtime-${ONNX_PROFILE}

USER root
ENV DEBIAN_FRONTEND=noninteractive
# RUNTIME_PACKAGES adds a profile's vendor runtime libraries (TensorRT) on top of a runtime
# base instead of shipping the vendor's development container.
ARG RUNTIME_PACKAGES=
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl ffmpeg \
      libcjson1 libmbedtls14t64 libmbedx509-1t64 libmbedcrypto7t64 \
      libxml2 librist4 libsrt1.5-openssl libsrtp2-1 libusrsctp2 \
      ${RUNTIME_PACKAGES} \
    && rm -rf /var/lib/apt/lists/*
# NVIDIA profiles also need the driver's video libraries mounted: MistProcAV encodes with
# NVENC there. Other profiles leave this empty and the NVIDIA toolkit ignores it.
ARG NVIDIA_DRIVER_CAPABILITIES=
ENV NVIDIA_DRIVER_CAPABILITIES=${NVIDIA_DRIVER_CAPABILITIES}

COPY --from=mist_build /mist-runtime/usr/local/ /usr/local/
COPY --from=mist_build /opt/mist-onnx/ /opt/mist-onnx/
RUN linkage="$(ldd /usr/local/bin/MistOutWebRTC)" \
    && echo "$linkage" \
    && for library in mbedtls mbedx509 mbedcrypto; do \
         echo "$linkage" | grep -E "lib${library}\\.so.*=> /usr/local/lib/"; \
       done

LABEL org.opencontainers.image.authors="Livepeer FrameWorks"
EXPOSE 4242 8080 1935 5554 8889/udp 18203/udp
ENTRYPOINT ["MistController"]
HEALTHCHECK CMD ["MistUtilHealth"]
